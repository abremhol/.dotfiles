#!/usr/bin/env bash
set -euo pipefail

# Requirements
command -v fzf >/dev/null 2>&1 || { echo "fzf is required. Install it and retry."; exit 1; }
command -v git >/dev/null 2>&1 || { echo "git is required."; exit 1; }

# Ensure we're in a git repo
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || { echo "Not inside a git repository."; exit 1; }

REPO_NAME=$(basename "$PWD")
CURRENT_BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")

echo "📥 Fetching all remote branches..."
git fetch --all --prune

# Collect candidate branch names:
#   - all local branches
#   - all origin/* branches (strip origin/)
#   - de-dup, exclude HEAD and current branch
mapfile -t CANDIDATES < <(
  {
    git for-each-ref --format='%(refname:short)' refs/heads
    git for-each-ref --format='%(refname:short)' refs/remotes/origin \
      | sed 's#^origin/##' \
      | grep -v '^HEAD$'
  } | sort -u | grep -v -F -x "${CURRENT_BRANCH:-__none__}"
)

if [ ${#CANDIDATES[@]} -eq 0 ]; then
  echo "No candidate branches found."
  exit 0
fi

# fzf with a preview of recent commits (from local if present, otherwise origin/<branch>)
SELECTED_BRANCH=$(
  printf '%s\n' "${CANDIDATES[@]}" | \
  fzf --prompt="Pick a branch to create a worktree for: " \
      --height=80% --reverse \
      --preview '
        br="{}";
        if git show-ref --verify --quiet "refs/heads/$br"; then
          git log --oneline --decorate --graph -n 20 "$br"
        else
          git log --oneline --decorate --graph -n 20 "origin/$br" 2>/dev/null || echo "No history available."
        fi
      ' \
      --preview-window=right:70%
)

# Cancel if nothing picked
[ -n "${SELECTED_BRANCH}" ] || { echo "No branch selected."; exit 0; }

# If local branch doesn't exist, create a tracking branch if a matching origin exists
if ! git show-ref --verify --quiet "refs/heads/$SELECTED_BRANCH"; then
  if git show-ref --verify --quiet "refs/remotes/origin/$SELECTED_BRANCH"; then
    echo "🔧 Creating local branch '$SELECTED_BRANCH' tracking 'origin/$SELECTED_BRANCH'..."
    git branch --track "$SELECTED_BRANCH" "origin/$SELECTED_BRANCH"
  else
    echo "⚠️ No local or origin branch named '$SELECTED_BRANCH' exists."; exit 1
  fi
fi

# Refuse if the branch already has a worktree attached
if git worktree list --porcelain | awk '/^branch /{print $2}' | sed 's#^refs/heads/##' | grep -Fxq "$SELECTED_BRANCH"; then
  echo "⚠️ A worktree for '$SELECTED_BRANCH' already exists:"
  git worktree list
  exit 0
fi

TARGET_DIR="../${REPO_NAME}-${SELECTED_BRANCH}"
if [ -d "$TARGET_DIR" ]; then
  echo "⚠️ Target directory already exists: $TARGET_DIR"
  echo "   Choose a different branch or remove/move that directory."
  exit 1
fi

echo "✅ Adding worktree for '$SELECTED_BRANCH' at '$TARGET_DIR'..."
git worktree add "$TARGET_DIR" "$SELECTED_BRANCH"

echo "🎉 Done!  (cd \"$TARGET_DIR\")"

